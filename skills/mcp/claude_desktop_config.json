{
  "mcpServers": {
    "github-extractor": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN=REEMPLAZA_CON_TU_TOKEN",
        "ghcr.io/github/github-mcp-server:latest"
      ]
    },
    "knowledge-graph-memory": {
      "command": "uvx",
      "args": [
        "mcp-server-sqlite",
        "--db-path",
        "~/.mcp-knowledge-graphs/heuristics_graph.db"
      ]
    }
  }
}
